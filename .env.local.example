# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-side only, never expose to the browser.
# Used for generating signed upload/download URLs and admin operations
# (e.g. creating request tokens) from server actions / route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name for uploaded documents (private bucket).
# Keep both of these in sync - the browser needs the public copy to call
# uploadToSignedUrl against the right bucket.
SUPABASE_DOCUMENTS_BUCKET=patient-documents
NEXT_PUBLIC_SUPABASE_DOCUMENTS_BUCKET=patient-documents

# Base URL used to build patient-facing secure links (e.g. https://app.example.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default expiry (in hours) for patient upload links and signed download URLs
DOCUMENT_REQUEST_LINK_TTL_HOURS=72
SIGNED_URL_TTL_SECONDS=300

# Days an uploaded document is kept before the retention job permanently
# deletes it (storage object + row). See src/lib/retention.ts.
DOCUMENT_RETENTION_DAYS=365

# Shared secret the retention cron job (vercel.json) must present as
# `Authorization: Bearer <value>` to POST /api/cron/purge-documents.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=change-me

# Resend API key for transactional email (provider "new document" alerts,
# patient upload receipts - see src/lib/email.ts). Sign up at resend.com,
# create an API key. Left unset, these emails just log to the console
# instead of sending - nothing breaks, you just won't see real emails.
RESEND_API_KEY=
# Sender address. onboarding@resend.dev works without any setup for
# testing; switch to an address on a domain you've verified with Resend
# before relying on this for real users.
EMAIL_FROM=onboarding@resend.dev
